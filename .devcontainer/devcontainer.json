{
  "name": "The Best Chromer",
  "image": "lscr.io/linuxserver/chrome:latest",
  "remoteUser": "root",
  "containerUser": "root",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "overrideCommand": false,
  "containerEnv": {
    "SELKIES_FRAMERATE": "60",
    "SELKIES_ENCODER": "h264",
    "SELKIES_ENCODER_PRESET": "ultrafast",
    "SELKIES_H264_CRF": "20",
    "SELKIES_MANUAL_RESOLUTION": "false",
    "CHROME_CLI": "--homepage file:///defaults/index.html --start-maximized --force-device-scale-factor=1 --high-dpi-support=1 --ignore-gpu-blocklist --enable-gpu-rasterization --enable-oop-rasterization --enable-accelerated-2d-canvas --enable-webgl --enable-webgl2-compute-context --enable-es3-apis --enable-features=UseSkiaRenderer,WebGLDraftExtensions,CanvasOopRasterization --use-gl=swiftshader --enable-unsafe-swiftshader --disable-gpu-sandbox --enable-zero-copy --num-raster-threads=8 --disable-blink-features=AutomationControlled"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vsliveshare.vsliveshare"
      ],
      "settings": {
        "liveshare.guestApprovalRequired": false
      }
    }
  },
  "postStartCommand": "bash .devcontainer/startup.sh",
  "otherPortsAttributes": {
    "label": "The Royal Chromer Web",
    "onAutoForward": "openBrowser"
  },
  "forwardPorts": [3000, 43083, 43084],
  "portsAttributes": {
    "3000": {
      "label": "Chrome Desktop",
      "onAutoForward": "notify"
    },
    "43083": {
      "label": "The Royal Chromer Web",
      "onAutoForward": "openBrowser"
    },
    "43084": {
      "label": "feedback",
      "onAutoForward": "notify"
    }
  }
}
